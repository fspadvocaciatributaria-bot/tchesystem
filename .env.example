# =============================================================================
# FSP — Variáveis de ambiente (EXEMPLO). Copie para .env.local e preencha.
# NUNCA commite valores reais. O frontend só pode usar chaves PUBLICÁVEIS (anon).
# =============================================================================

# URL do projeto Supabase (ex.: https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave pública (anon/publishable) — segura para o frontend, protegida por RLS
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# APENAS backend/CLI/migrações — NÃO exponha no frontend, NÃO use com prefixo VITE_
# Usada localmente pela Supabase CLI / scripts de seed com privilégio elevado.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=
